{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    
    "dev": "wt deno task dev:api ';' sp deno task dev:vite",
    "dev:api": "deno serve --watch --allow-net ./src/server.ts",
    "dev:vite": "deno run -A npm:vite",
    
    "debug": "deno task debug:api && deno task dev:vite",
    "debug:api": "wt deno serve --inspect --allow-net ./src/server.ts",
    
    "build": "vite build",
    "server:start": "deno serve -A --watch ./src/server.ts",
    "serve": "deno run build && deno run server:start",
    "preview": "vite preview"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "imports": {
    "@/": "./src/",
    "@deno/vite-plugin": "npm:@deno/vite-plugin@^2.0.3",
    "msgpack": "jsr:@std/msgpack@^1.0.3",
    "@tsconfig/node24": "npm:@tsconfig/node24@^24.0.4",
    "@vue/tsconfig": "npm:@vue/tsconfig@^0.9.1",
    "hono": "jsr:@hono/hono@^4.12.33",
    "@vitejs/plugin-vue": "npm:@vitejs/plugin-vue@^6.0.8",
    "pinia": "npm:pinia@^4.0.2",
    "vite": "npm:vite@^8.2.0",
    "vue": "npm:vue@^3.5.40",
    "vue-router": "npm:vue-router@^5.2.0",
    "vue-tsc": "npm:vue-tsc@^3.3.9"
  },
  "compilerOptions": {
    "lib": ["dom", "dom.asynciterable", "dom.iterable", "deno.ns"],
    "types": ["vite/client"]
  }
}
